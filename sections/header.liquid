{%- assign menu = section.settings.menu -%}
<header class="header">
  <nav class="header__nav" aria-label="{{ 'sections.header.menu' | t }}">
    {%- if menu != blank -%}
      {%- for link in linklists[menu].links -%}
        <a
          class="header__nav-link{% if link.active or link.child_active %} header__nav-link--active{% endif %}"
          href="{{ link.url }}"
          {% if link.current %}aria-current="page"{% endif %}
        >
          {{- link.title | escape -}}
        </a>
      {%- endfor -%}
    {%- else -%}
      <a class="header__nav-link" href="{{ routes.all_products_collection_url }}">Shop</a>
      <a class="header__nav-link" href="/pages/household">Household</a>
      <a class="header__nav-link" href="/pages/gifting">Gifting</a>
    {%- endif -%}
  </nav>

  <a class="header__logo" href="{{ routes.root_url }}">
    <span class="visually-hidden">{{ shop.name }}</span>
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 300 | image_tag: alt: shop.name, class: 'logo-mark' }}
    {%- else -%}
      {% render 'logo-mark' %}
    {%- endif -%}
  </a>

  <div class="header__actions">
    <a class="header__cart" href="{{ routes.cart_url }}" aria-label="{{ 'sections.header.cart' | t }}">
      {% render 'icon-basket' %}
      <span class="header__cart-count" data-cart-count>{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Design uses: Shop, Household, Gifting."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom logo",
      "info": "Leave empty to use the AnnMarie monogram from the design."
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
