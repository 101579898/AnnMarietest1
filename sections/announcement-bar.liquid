{%- unless section.settings.hide_on_home and request.page_type == 'index' -%}
  <div class="announcement" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    {%- if section.settings.link != blank -%}
      <a class="announcement__link" href="{{ section.settings.link }}">
        <span class="announcement__text">{{ section.settings.text | escape }}</span>
        <span class="announcement__arrow" aria-hidden="true">&rarr;</span>
      </a>
    {%- else -%}
      <span class="announcement__text">{{ section.settings.text | escape }}</span>
    {%- endif -%}
  </div>
{%- endunless -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Sign up to Newsletter" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "checkbox",
      "id": "hide_on_home",
      "label": "Hide on home page",
      "info": "The Figma home page has no banner; the other pages do.",
      "default": true
    }
  ],
  "presets": [{ "name": "Announcement bar" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
