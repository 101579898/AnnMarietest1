<section class="collection">
  <h1 class="display-heading page-title">{{ 'search.title' | t }}</h1>
  <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'search.placeholder' | t }}">
    <input type="hidden" name="type" value="product">
    <button class="button button--ui" type="submit">{{ 'search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 20 -%}
      {%- if search.results_count > 0 -%}
        <ul class="product-grid" role="list" style="margin-top:40px">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              <li>{% render 'product-card', product: item %}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="collection__empty">{{ 'search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Search results" }
{% endschema %}
