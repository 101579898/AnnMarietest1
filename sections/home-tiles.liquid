{%- comment -%} Two image links under the hero — "Shop" and "Household" (164:31561). {%- endcomment -%}
<section class="home-tiles">
  {%- for block in section.blocks -%}
    {%- liquid
      assign fallback = 'home-tile-shop.png'
      if forloop.index == 2
        assign fallback = 'home-tile-household.png'
      endif
    -%}
    <a class="home-tile" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {{
          block.settings.image
          | image_url: width: 1600
          | image_tag: class: 'home-tile__image', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1200, 1600', loading: 'lazy', alt: block.settings.image.alt
        }}
        <span class="home-tile__overlay" style="--overlay: {{ block.settings.overlay | divided_by: 100.0 }};"></span>
      {%- else -%}
        <img class="home-tile__image" src="{{ fallback | asset_url }}" alt="" width="706" height="246" loading="lazy">
      {%- endif -%}
      <span class="home-tile__label">{{ block.settings.label | escape }}</span>
    </a>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Image links",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the image from the design." },
        { "type": "range", "id": "overlay", "label": "Image darkening", "min": 0, "max": 60, "step": 2, "unit": "%", "default": 10 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image links",
      "blocks": [
        { "type": "tile", "settings": { "label": "Shop" } },
        { "type": "tile", "settings": { "label": "Household" } }
      ]
    }
  ]
}
{% endschema %}
