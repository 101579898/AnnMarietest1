{%- comment -%} Household page intro: heading, line, landscape image, monogram, story (164:32018, 164:31955, 164:32014, 164:32009). {%- endcomment -%}
<section class="story-intro">
  <h1 class="display-heading story-intro__heading">{{ section.settings.heading | escape }}</h1>
  {%- if section.settings.subheading != blank -%}
    <p class="story-intro__subheading">{{ section.settings.subheading | escape }}</p>
  {%- endif -%}

  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'story-intro__image', sizes: '(min-width: 750px) 677px, 100vw', widths: '700, 1000, 1400', alt: section.settings.image.alt }}
  {%- else -%}
    <img class="story-intro__image" src="{{ 'landscape.png' | asset_url }}" alt="" width="2000" height="1600">
  {%- endif -%}

  {%- if section.settings.show_mark -%}
    <img class="story-intro__mark" src="{{ 'monogram-small.svg' | asset_url }}" alt="" width="50" height="65" loading="lazy">
  {%- endif -%}

  {%- if section.settings.text != blank -%}
    <div class="body-large story-intro__text">{{ section.settings.text }}</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Story intro",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Named for the women who made us." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "AnnMarie is a dedication to lineage, to ritual, to the luxury of presence." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the image from the design." },
    { "type": "checkbox", "id": "show_mark", "label": "Show monogram", "default": true },
    {
      "type": "richtext",
      "id": "text",
      "label": "Story",
      "default": "<p>AnnMari was named for the women who moved with elegance and certainty — matriarchs who poured into others before pouring for themselves. She is part memory, part movement: born in Toronto, shaped by diaspora, and made for the global citizen who never arrives empty-handed. She travels light but leaves a trail. One foot in Florence, the other in Freetown. The kind of woman who knows the sommelier by name, and the back route home by instinct. She hosts like a native, shops like a local, and orders the wine before the menus even arrive. AnnMari is not just who we are. She’s how we live.</p>"
    }
  ],
  "presets": [{ "name": "Story intro" }]
}
{% endschema %}
